      },
      "target": "antenna_mast",
      "animation": "install",
      "duration_ms": 3000,
      "requires": [
        {
          "type": "item",
          "id": "antenna_kit"
        },
        {
          "type": "item",
          "id": "wrench"
        },
        {
          "type": "objective",
          "id": "diagnose_link"
        }
      ],
      "effects": {
        "items": {
          "antenna_kit": -1
        },
        "world": {
          "comms.antenna_aligned": true
        },
        "equipment_wear": {
          "wrench": 4
        }
      },
      "score": 16
    },
    {
      "id": "restore_link",
      "title": {
        "en": "Restore the link",
        "ar": "رجّع الاتصال"
      },
      "hint": {
        "en": "Power up the transceiver and lock the carrier.",
        "ar": "شغّل جهاز الإرسال واقفل على الإشارة."
      },
      "target": "comms_rack",
      "animation": "confirm",
      "duration_ms": 1800,
      "requires": [
        {
          "type": "world",
          "path": "comms.antenna_aligned",
          "op": "eq",
          "value": true
        }
      ],
      "effects": {
        "world": {
          "comms_online": true
        },
        "flags_set": [
          "comms_online"
        ],
        "resources": {
          "power": -3
        }
      },
      "score": 16,
      "success_message": {
        "en": "Carrier locked. Control has you loud and clear.",
        "ar": "تم قفل الإشارة. المركز بيسمعك بوضوح."
      }
    },
    {
      "id": "send_status_report",
      "title": {
        "en": "Send the status report",
        "ar": "ابعت تقرير الحالة"
