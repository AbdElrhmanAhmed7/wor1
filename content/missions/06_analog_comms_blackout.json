      "effects": {
        "items": {
          "antenna_kit": 1
        }
      },
      "score": 6
    },
    {
      "id": "realign_antenna",
      "title": {
        "en": "Realign the antenna",
        "ar": "اضبط توجيه الهوائي"
      },
      "hint": {
        "en": "Outside on the mast: fit the kit and peak the signal.",
