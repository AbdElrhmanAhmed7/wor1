{
  "id": "analog_comms_blackout",
  "stage": 2,
  "title": {
    "en": "Communications Blackout",
    "ar": "انقطاع الاتصالات"
  },
  "summary": {
    "en": "Diagnose the dead link, realign the antenna and restore contact with control.",
    "ar": "شخّص الاتصال المقطوع، اضبط الهوائي ورجّع التواصل مع مركز التحكم."
  },
  "environment": "earth_analog",
  "estimated_minutes": 6,
  "requires_missions": [
    "analog_power_link"
  ],
  "briefing": [
    {
      "en": "No comms means no rescue. Treat it as an emergency, not an inconvenience.",
      "ar": "مفيش اتصال يعني مفيش إنقاذ. اتعامل معاه كطوارئ مش إزعاج."
    }
  ],
  "objectives": [
    {
      "id": "diagnose_link",
      "title": {
        "en": "Diagnose the link",
        "ar": "شخّص الاتصال"
      },
      "hint": {
        "en": "Measure the transceiver supply and signal path.",
        "ar": "قيس تغذية جهاز الإرسال ومسار الإشارة."
      },
      "target": "comms_rack",
      "animation": "measure",
      "duration_ms": 1800,
      "requires": [
        {
          "type": "item",
          "id": "multimeter"
        }
      ],
      "effects": {
        "world": {
          "comms.diagnosed": true
        },
        "resources": {
          "power": -2
        },
        "equipment_wear": {
          "multimeter": 3
        }
      },
      "score": 12,
      "success_message": {
        "en": "Power is fine – the antenna is off-axis.",
        "ar": "الطاقة سليمة – الهوائي خارج المحور."
      }
    },
    {
      "id": "fetch_antenna_kit",
      "title": {
        "en": "Collect the antenna kit",
        "ar": "خد طقم الهوائي"
