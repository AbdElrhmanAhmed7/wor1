      "animation": "read_terminal",
      "duration_ms": 1400,
      "requires": [
        {
          "type": "flag",
          "id": "comms_online"
        }
      ],
      "effects": {
        "flags_set": [
          "analog.status_sent"
        ],
        "readiness": 2.0
      },
      "score": 10
    }
